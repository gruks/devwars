# Secure Sandbox Container
# This container runs untrusted code with strict security constraints
FROM node:18-alpine

# Security: Use existing node user (UID/GID 1000 in node:alpine)
# The node user already exists in node:alpine images

# Install required runtimes (minimal versions)
RUN apk add --no-cache \
    python3 \
    openjdk11 \
    g++ \
    bash \
    util-linux \
    coreutils

# Set working directory
WORKDIR /sandbox

# Create temp directory for code files
RUN mkdir -p /sandbox && \
    chown -R node:node /sandbox

# Switch to non-root user (node user from base image)
USER node

# No ENTRYPOINT - commands are passed directly via docker run
# Example: docker run devwars-sandbox node /sandbox/code.js
